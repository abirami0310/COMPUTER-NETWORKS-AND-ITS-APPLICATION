

bool isOneBitCharacter(int* bits, int bitsSize) {
    int i = 0;
    
    // Iterate through the array up to the second-to-last element
    while (i < bitsSize - 1) {
        if (bits[i] == 1) {
            i += 2; // Skip the next bit since it's a two-bit character
        } else {
            i += 1; // Move to the next bit since it's a one-bit character
        }
    }
    
    // If we end exactly at the last index, the last character is a 1-bit character
    return i == bitsSize - 1;
}

