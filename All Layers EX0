#include<stdio.h>
#include<string.h>
#include<stdlib.h>
#include<time.h>

#define MAX_FILE_SIZE    10000
#define MAX_PACKET_SIZE  1000
#define MAX_FRAME_SIZE   1000
#define MAX_PACKETS_REC  300
#define MAX_FRAMES_REC   2000
#define SEP "-----------------------------------------------------------------------------------------------\n"



struct AddressTable{char url[30];char ip[16];char mac[18];};

struct AddressTable table[5]={
    {"www.google.com","192.168.1.10","AA:BB:CC:DD:EE:01"},
    {"www.yahoo.com","192.168.1.20","AA:BB:CC:DD:EE:02"},
    {"www.gmail.com","192.168.1.30","AA:BB:CC:DD:EE:03"},
    {"www.amazon.com","192.168.1.40","AA:BB:CC:DD:EE:04"},
    {"www.facebook.com","192.168.1.50","AA:BB:CC:DD:EE:05"}
};



char fileName[30];
char sourceURL[30];
char destinationURL[30];
int  sourceIndex;
int  destinationIndex;

char fileData[MAX_FILE_SIZE];
int  totalChars;

int  packetSize;
int  frameSize;

int  sourcePort;
int  destPort;
char sourcePortBin[17];
char destPortBin[17];

char srcIPBin[33];
char destIPBin[33];
char srcMACBin[49];
char destMACBin[49];

int  totalPackets;
int  totalFrames;
long totalPhysicalBits;


char fileDataBin[MAX_FILE_SIZE*8+1];


typedef struct{
    int  packetNum;
    char dataBin[MAX_PACKET_SIZE*8+1];   
    int  actualLen;                      
}PacketRecord;

typedef struct{
    int  frameNum;      
    int  packetNum;     
    char dataBin[MAX_FRAME_SIZE*8+1];
}FrameRecord;

PacketRecord packetRecords[MAX_PACKETS_REC];
FrameRecord  frameRecords[MAX_FRAMES_REC];
int packetRecCount=0;
int frameRecCount=0;



int searchURL(char url[])
{
    int i;
    for(i=0;i<5;i++)
    {
        if(strcmp(url,table[i].url)==0) return i;
    }
    return -1;
}



void charToBinary(unsigned char ch,char binary[])
{
    int i;
    int value=(int)ch;
    for(i=7;i>=0;i--)
    {
        binary[i]=(value%2==0)?'0':'1';
        value/=2;
    }
    binary[8]='\0';
}

void decimalToBinary8(int num,char binary[])
{
    int i;
    for(i=7;i>=0;i--)
    {
        binary[i]=(num%2==0)?'0':'1';
        num/=2;
    }
    binary[8]='\0';
}

void decimalToBinary16(int num,char binary[])
{
    int i;
    for(i=15;i>=0;i--)
    {
        binary[i]=(num%2==0)?'0':'1';
        num/=2;
    }
    binary[16]='\0';
}

void hexDigitToBinary(char hex,char binary[])
{
    switch(hex)
    {
        case '0': strcpy(binary,"0000"); break;
        case '1': strcpy(binary,"0001"); break;
        case '2': strcpy(binary,"0010"); break;
        case '3': strcpy(binary,"0011"); break;
        case '4': strcpy(binary,"0100"); break;
        case '5': strcpy(binary,"0101"); break;
        case '6': strcpy(binary,"0110"); break;
        case '7': strcpy(binary,"0111"); break;
        case '8': strcpy(binary,"1000"); break;
        case '9': strcpy(binary,"1001"); break;
        case 'A': case 'a': strcpy(binary,"1010"); break;
        case 'B': case 'b': strcpy(binary,"1011"); break;
        case 'C': case 'c': strcpy(binary,"1100"); break;
        case 'D': case 'd': strcpy(binary,"1101"); break;
        case 'E': case 'e': strcpy(binary,"1110"); break;
        case 'F': case 'f': strcpy(binary,"1111"); break;
    }
}

void ipToBinary(char ip[], char binary[])
{
    int i=0,j=0,num=0,k;
    char temp[9];
    while(ip[i]!='\0')
    {
        if(ip[i]!='.') num=num*10+(ip[i]-'0');
        else
        {
            decimalToBinary8(num,temp);
            for(k=0;k<8;k++) binary[j++]=temp[k];
            num=0;
        }
        i++;
    }
    decimalToBinary8(num,temp);
    for(k=0;k<8;k++) binary[j++]=temp[k];
    binary[32]='\0';
}

void macToBinary(char mac[], char binary[])
{
    int i,j=0,k;
    char temp[5];
    for(i=0;mac[i]!='\0';i++)
    {
        if(mac[i]!=':')
        {
            hexDigitToBinary(mac[i],temp);
            for(k=0;k<4;k++) binary[j++]=temp[k];
        }
    }
    binary[48]='\0';
}

int generateRandomPort()
{
    return 1024 + rand()%(65535-1024+1);
}


void buildBinaryString(char data[], int len, char out[])
{
    int i,pos=0;
    char cb[9];
    for(i=0;i<len;i++)
    {
        charToBinary((unsigned char)data[i],cb);
        strcpy(out+pos,cb);
        pos+=8;
    }
    out[pos]='\0';
}


int getUserInput()
{
    printf("Enter File Name : ");
    scanf("%s",fileName);
    printf("Enter Source URL : ");
    scanf("%s",sourceURL);
    printf("Enter Destination URL : ");
    scanf("%s",destinationURL);

    packetSize = 40;   
    frameSize  = 8;    

    printf("Packet Size in bytes (Network Layer segmentation) : %d\n",packetSize);
    printf("Frame Size in bytes (Data Link Layer fragmentation) : %d\n",frameSize);

    if(packetSize<=0 || packetSize>MAX_PACKET_SIZE)
    {
        printf("\nInvalid Packet Size (1 - %d allowed)\n",MAX_PACKET_SIZE);
        return 1;
    }
    if(frameSize<=0 || frameSize>MAX_FRAME_SIZE)
    {
        printf("\nInvalid Frame Size (1 - %d allowed)\n",MAX_FRAME_SIZE);
        return 1;
    }
    return 0;
}


int validateAddresses()
{
    sourceIndex=searchURL(sourceURL);
    destinationIndex=searchURL(destinationURL);
    if(sourceIndex==-1 || destinationIndex==-1)
    {
        printf("\nInvalid URL");
        return 1;
    }
    return 0;
}


int readInputFile()
{
    int ch;

    if(freopen(fileName,"r",stdin)==NULL)
    {
        printf("\nFile Not Found");
        return 1;
    }

    totalChars=0;
    while((ch=getchar())!=EOF && totalChars<MAX_FILE_SIZE)
    {
        fileData[totalChars++]=(char)ch;
    }

    if(totalChars==0)
    {
        printf("\nFile is empty");
        return 1;
    }
    return 0;
}


void precomputeAddresses()
{
    ipToBinary(table[sourceIndex].ip, srcIPBin);
    ipToBinary(table[destinationIndex].ip, destIPBin);
    macToBinary(table[sourceIndex].mac, srcMACBin);
    macToBinary(table[destinationIndex].mac, destMACBin);
}



void applicationLayer()
{
    int i;

    printf("\n=================================================\n");
    printf("               APPLICATION LAYER\n");
    printf("=================================================\n");


    sourcePort = generateRandomPort();
    destPort   = generateRandomPort();

    printf("Source Host       : %s\n",sourceURL);
    printf("Destination Host  : %s\n",destinationURL);
    printf("Message / File    : %s\n",fileName);
    printf("Message Size      : %d bytes\n",totalChars);
    printf("Generated Source Port      : %d\n",sourcePort);
    printf("Generated Destination Port : %d\n",destPort);

    printf("Message Content (Characters) : ");
    for(i=0;i<totalChars;i++) putchar(fileData[i]);
    printf("\n");

   buildBinaryString(fileData,totalChars,fileDataBin);

    printf("\nAPPLICATION LAYER\n\n");
    printf("%-15s %-20s %-15s %-10s %s\n",
           "Source Host","Destination Host","File","Size","Data (Binary)");
    printf(SEP);
    printf("%-15s %-20s %-15s %-10d %s\n",
           sourceURL,destinationURL,fileName,totalChars,fileDataBin);

    printf("\nData handed down to Transport Layer...\n");
}



void transportLayer()
{
    decimalToBinary16(sourcePort, sourcePortBin);
    decimalToBinary16(destPort, destPortBin);

    printf("\n=================================================\n");
    printf("               TRANSPORT LAYER\n");
    printf("=================================================\n");
    printf("Source Port           : %d\n",sourcePort);
    printf("Source Port (Binary)  : %s\n",sourcePortBin);
    printf("Destination Port          : %d\n",destPort);
    printf("Destination Port (Binary) : %s\n",destPortBin);
    printf("Total Data Size (bytes)   : %d\n",totalChars);
    printf("Packet Size (bytes)       : %d\n",packetSize);

    totalPackets = totalChars/packetSize;
    if(totalChars%packetSize!=0) totalPackets++;

    printf("Total Packets to be created (segmentation) : %d\n",totalPackets);

    printf("\nTRANSPORT LAYER\n\n");
    printf("%-18s %-20s %s\n","sourceport","destinationport","data");
    printf(SEP);
    printf("%-18s %-20s %s\n",sourcePortBin,destPortBin,fileDataBin);
}




void networkLayer()
{
    int i,j;

    printf("\n=================================================\n");
    printf("               NETWORK LAYER\n");
    printf("=================================================\n");

    printf("\nNETWORK LAYER\n\n");
    printf("%-8s %-18s %-18s %-16s %-16s %s\n",
           "Packet","Source Port","Dest Port","Source IP","Dest IP","Data");
    printf(SEP);

    for(i=0;i<totalPackets;i++)
    {
        int pStart=i*packetSize;
        int pLen = (pStart+packetSize<=totalChars) ? packetSize : (totalChars-pStart);
        int padBytes = packetSize - pLen;
        char packetBytes[MAX_PACKET_SIZE];
        char packetDataBin[MAX_PACKET_SIZE*8+1];

        for(j=0;j<pLen;j++) packetBytes[j]=fileData[pStart+j];
        for(j=pLen;j<packetSize;j++) packetBytes[j]=0; /* zero padding */

        buildBinaryString(packetBytes,packetSize,packetDataBin);


        printf("%-8d %-18s %-18s %-16s %-16s %s\n",
               i+1,sourcePortBin,destPortBin,srcIPBin,destIPBin,packetDataBin);


        printf("\n-------------------------------------------------\n");
        printf("            NETWORK LAYER - Packet %d\n",i+1);
        printf("-------------------------------------------------\n");
        printf("Source IP      : %s\n",table[sourceIndex].ip);
        printf("Source IP(Bin) : %s\n",srcIPBin);
        printf("Destination IP      : %s\n",table[destinationIndex].ip);
        printf("Destination IP(Bin) : %s\n",destIPBin);
        printf("Actual Data Bytes = %d , Padding Bytes = %d\n",pLen,padBytes);
        printf("Data (char : binary):\n");
        for(j=0;j<packetSize;j++)
        {
            char cb[9];
            charToBinary((unsigned char)packetBytes[j],cb);
            if(j<pLen)
                printf("  ['%c'->%s]",packetBytes[j],cb);
            else
                printf("  [PAD->%s]",cb);
            if((j+1)%4==0) printf("\n");
        }
        if(packetSize%4!=0) printf("\n");

        printf("Frame Size (bytes) : %d\n",frameSize);
        printf("Frames needed for Packet %d : %d\n",i+1,
               (packetSize/frameSize)+((packetSize%frameSize!=0)?1:0));


        if(packetRecCount<MAX_PACKETS_REC)
        {
            packetRecords[packetRecCount].packetNum=i+1;
            packetRecords[packetRecCount].actualLen=pLen;
            strcpy(packetRecords[packetRecCount].dataBin,packetDataBin);
            packetRecCount++;
        }
    }
}


void dataLinkLayer()
{
    int i,j,k;

    printf("\n=================================================\n");
    printf("               DATA LINK LAYER\n");
    printf("=================================================\n");

    printf("\nDATA LINK LAYER\n\n");
    printf("%-6s %-8s %-18s %-18s %-16s %-16s %-52s %-52s %-70s %s\n",
           "Frame","Packet","Src Port","Dst Port","Src IP","Dst IP",
           "Src MAC","Dst MAC","Data","Trailer");
    printf(SEP);

    for(i=0;i<packetRecCount;i++)
    {
        int fCountThisPacket = packetSize/frameSize;
        if(packetSize%frameSize!=0) fCountThisPacket++;

        for(j=0;j<fCountThisPacket;j++)
        {
            int fStart=j*frameSize;                 /* byte offset within packet */
            int fLen=(fStart+frameSize<=packetRecords[i].actualLen)
                        ? frameSize
                        : (packetRecords[i].actualLen-fStart>0 ? packetRecords[i].actualLen-fStart : 0);
            int fPad=frameSize-fLen;
            char frameDataBin[MAX_FRAME_SIZE*8+1];


            strncpy(frameDataBin, packetRecords[i].dataBin + fStart*8, frameSize*8);
            frameDataBin[frameSize*8]='\0';

            totalFrames++;


            printf("%-6d %-8d %-18s %-18s %-16s %-16s %-52s %-52s %-70s %s\n",
                   totalFrames,packetRecords[i].packetNum,
                   sourcePortBin,destPortBin,
                   srcIPBin,destIPBin,
                   srcMACBin,destMACBin,
                   frameDataBin,"00000000");


            printf("\n  ...............................................\n");
            printf("     Frame %d (of Packet %d)\n",j+1,packetRecords[i].packetNum);
            printf("  ...............................................\n");
            printf("  Source MAC          : %s\n",table[sourceIndex].mac);
            printf("  Source MAC (Binary) : %s\n",srcMACBin);
            printf("  Destination MAC          : %s\n",table[destinationIndex].mac);
            printf("  Destination MAC (Binary) : %s\n",destMACBin);
            printf("  Frame Payload: Actual = %d bytes, Padding = %d bytes\n",fLen,fPad);
            printf("  Data (Binary): %s\n",frameDataBin);
            printf("  Trailer (CRC placeholder) : 00000000\n");


            if(frameRecCount<MAX_FRAMES_REC)
            {
                frameRecords[frameRecCount].frameNum=totalFrames;
                frameRecords[frameRecCount].packetNum=packetRecords[i].packetNum;
                strcpy(frameRecords[frameRecCount].dataBin,frameDataBin);
                frameRecCount++;
            }
            (void)k;
        }
    }
}


void physicalLayer()
{
    int i;

    printf("\n=================================================\n");
    printf("               PHYSICAL LAYER\n");
    printf("=================================================\n");
    printf("PHYSICAL LAYER - All Bits Transmitted\n\n");
    printf("%-6s %-8s %s\n","Frame","Packet","Bit Stream (SrcMAC+DstMAC+Data+Trailer)");
    printf(SEP);

    totalPhysicalBits=0;
    for(i=0;i<frameRecCount;i++)
    {
        printf("%-6d %-8d %s%s%s%s\n",
               frameRecords[i].frameNum,
               frameRecords[i].packetNum,
               srcMACBin,destMACBin,frameRecords[i].dataBin,"00000000");

        totalPhysicalBits += (long)(strlen(srcMACBin)+strlen(destMACBin)
                                    +strlen(frameRecords[i].dataBin)+8);
    }

    printf("\nTotal Bits Transmitted (Physical Layer) : %ld\n",totalPhysicalBits);
}



void printSummary()
{
    printf("\n=================================================\n");
    printf("                   SUMMARY\n");
    printf("=================================================\n");
    printf("Total Characters in File               : %d\n",totalChars);
    printf("Total Packets Created (Network Layer)  : %d\n",totalPackets);
    printf("Total Frames Created (Data Link Layer) : %d\n",totalFrames);
    printf("Total Bits Transmitted (Physical Layer): %ld\n",totalPhysicalBits);
}



int main()
{
    srand((unsigned)time(NULL));

    if(getUserInput()!=0)      return 0;
    if(validateAddresses()!=0) return 0;
    if(readInputFile()!=0)     return 0;

    precomputeAddresses();

    applicationLayer();
    transportLayer();
    networkLayer();
    dataLinkLayer();
    physicalLayer();
    printSummary();

    return 0;
}
