#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>
#define SERV_PORT 1321     
int main(void)
{
  
    int ls;                            
    int s;                            
    int buffer[256];                 
    int size;                   
    int sum;                   
    int waitSize = 16;        
    int clntAddrLen;         
    int i;
    struct sockaddr_in servAddr;       
    struct sockaddr_in clientAddr;    
    memset(&servAddr, 0, sizeof(servAddr));
    servAddr.sin_family = AF_INET;
    servAddr.sin_addr.s_addr = htonl(INADDR_ANY);
    servAddr.sin_port = htons(SERV_PORT);
    if ((ls = socket(PF_INET, SOCK_STREAM, 0)) < 0)
    {
        perror("Error: Listen socket failed!");
        exit(1);
    }
     if (bind(ls, (struct sockaddr *)&servAddr, sizeof(servAddr)) < 0)
    {
        perror("Error: Binding failed!");
        exit(1);
    }
    if (listen(ls, waitSize) < 0)
    {
        perror("Error: Listening failed!");
        exit(1);
    }
    printf("TCP Sum Server running on port %d...\n", SERV_PORT);
    clntAddrLen = sizeof(clientAddr);
        if ((s = accept(ls, (struct sockaddr *)&clientAddr, (socklen_t *)&clntAddrLen)) < 0)
        {
            perror("Error: Accept failed!");
            
        }      
        recv(s, &size, sizeof(int), 0);
	recv(s, buffer, size * sizeof(int), 0);
        printf("\nArray received from client: ");
        for (i = 0; i < size; i++)
            printf("%d ", buffer[i]);
        printf("\n");
        sum = 0;
        for (i = 0; i < size; i++)
            sum += buffer[i];
       printf("Sum of array elements: %d\n", sum);
       send(s, &sum, sizeof(int), 0);
       close(s);
    return 0;
} 



