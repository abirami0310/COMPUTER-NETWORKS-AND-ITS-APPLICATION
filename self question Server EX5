#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>
#include <sys/wait.h>

#define PORT 8080
#define BUFFER_SIZE 1024
#define LOG_FILE "server_activity.log"

// Valid hardcoded credentials
#define AUTH_USER "admin"
#define AUTH_PASS "password123"

// Write client tracking info with timestamps to a centralized log file
void log_activity(const char *ip, int port, const char *activity) {
    FILE *log = fopen(LOG_FILE, "a");
    if (!log) return;
    
    time_t now = time(NULL);
    char *time_str = ctime(&now);
    time_str[strlen(time_str) - 1] = '\0'; // Remove newline
    
    fprintf(log, "[%s] Client %s:%d -> %s\n", time_str, ip, port, activity);
    fclose(log);
}

// Check credentials sent by client
int authenticate_client(int client_fd, const char *ip, int port) {
    char username[50] = {0};
    char password[50] = {0};
    
    if (recv(client_fd, username, sizeof(username), 0) <= 0) return 0;
    if (recv(client_fd, password, sizeof(password), 0) <= 0) return 0;

    if (strcmp(username, AUTH_USER) == 0 && strcmp(password, AUTH_PASS) == 0) {
        char status[] = "SUCCESS";
        send(client_fd, status, strlen(status), 0);
        log_activity(ip, port, "Authentication Successful");
        return 1;
    } else {
        char status[] = "FAILED";
        send(client_fd, status, strlen(status), 0);
        log_activity(ip, port, "Authentication Failed");
        return 0;
    }
}

// Receive a file from the client
void handle_upload(int client_fd, const char *ip, int port) {
    char filename[256] = {0};
    long filesize = 0;
    
    // Receive filename and file size
    if (recv(client_fd, filename, sizeof(filename), 0) <= 0) return;
    if (recv(client_fd, &filesize, sizeof(filesize), 0) <= 0) return;

    // Save uploaded file with a prefix to prevent collision
    char server_filename[300];
    snprintf(server_filename, sizeof(server_filename), "uploaded_%s", filename);

    FILE *fp = fopen(server_filename, "wb");
    if (!fp) {
        log_activity(ip, port, "Upload Failed (Cannot write file)");
        return;
    }

    char buffer[BUFFER_SIZE];
    long total_received = 0;
    while (total_received < filesize) {
        int bytes_to_read = (filesize - total_received < BUFFER_SIZE) ? (filesize - total_received) : BUFFER_SIZE;
        int read_bytes = recv(client_fd, buffer, bytes_to_read, 0);
        if (read_bytes <= 0) break;
        fwrite(buffer, 1, read_bytes, fp);
        total_received += read_bytes;
    }
    fclose(fp);
    
    char msg[100];
    snprintf(msg, sizeof(msg), "Uploaded file successfully: %s (%ld bytes)", filename, filesize);
    log_activity(ip, port, msg);
}

// Send a requested file back to the client
void handle_download(int client_fd, const char *ip, int port) {
    char filename[256] = {0};
    if (recv(client_fd, filename, sizeof(filename), 0) <= 0) return;

    FILE *fp = fopen(filename, "rb");
    long filesize = 0;

    if (!fp) {
        // Send file size as -1 if the file doesn't exist
        filesize = -1;
        send(client_fd, &filesize, sizeof(filesize), 0);
        char err_msg[300];
        snprintf(err_msg, sizeof(err_msg), "Requested missing download file: %s", filename);
        log_activity(ip, port, err_msg);
        return;
    }

    // Calculate file size
    fseek(fp, 0, SEEK_END);
    filesize = ftell(fp);
    fseek(fp, 0, SEEK_SET);

    // Send valid file size to client
    send(client_fd, &filesize, sizeof(filesize), 0);

    char buffer[BUFFER_SIZE];
    int read_bytes;
    while ((read_bytes = fread(buffer, 1, BUFFER_SIZE, fp)) > 0) {
        send(client_fd, buffer, read_bytes, 0);
    }
    fclose(fp);
    
    char msg[300];
    snprintf(msg, sizeof(msg), "Downloaded file successfully: %s", filename);
    log_activity(ip, port, msg);
}

// Main loop managing an authenticated client process session
void serve_client(int client_fd, const char *ip, int port) {
    if (!authenticate_client(client_fd, ip, port)) {
        close(client_fd);
        exit(0);
    }

    int choice = 0;
    while (1) {
        if (recv(client_fd, &choice, sizeof(choice), 0) <= 0) {
            log_activity(ip, port, "Connection dropped unexpectedly.");
            break;
        }

        if (choice == 1) { // Upload
            handle_upload(client_fd, ip, port);
        } 
        else if (choice == 2) { // Download
            handle_download(client_fd, ip, port);
        } 
        else if (choice == 3) { // Date and Time
            time_t now = time(NULL);
            char *dt_str = ctime(&now);
            send(client_fd, dt_str, strlen(dt_str), 0);
            log_activity(ip, port, "Requested server date and time");
        } 
        else if (choice == 4) { // System Info
            FILE *sys_file = popen("uname -a", "r");
            char sys_info[BUFFER_SIZE] = {0};
            if (sys_file) {
                fgets(sys_info, sizeof(sys_info), sys_file);
                pclose(sys_file);
            } else {
                strcpy(sys_info, "Unknown UNIX Environment\n");
            }
            send(client_fd, sys_info, strlen(sys_info), 0);
            log_activity(ip, port, "Requested system information");
        } 
        else if (choice == 5) { // Terminate
            log_activity(ip, port, "Terminated session gracefully");
            break;
        } 
        else {
            log_activity(ip, port, "Sent an invalid action menu payload");
        }
    }
    close(client_fd);
    exit(0);
}

// Zombie process reaper to avoid memory leaks
void sigchld_handler(int s) {
    while(waitpid(-1, NULL, WNOHANG) > 0);
}

int main() {
    int server_fd, client_fd;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);
    int opt = 1;

    // Handle zombie cleanup asynchronously
    struct sigaction sa;
    sa.sa_handler = sigchld_handler;
    sigemptyset(&sa.sa_mask);
    sa.sa_flags = SA_RESTART;
    sigaction(SIGCHLD, &sa, NULL);

    server_fd = socket(AF_INET, SOCK_STREAM, 0);
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failure");
        exit(1);
    }

    listen(server_fd, 10);
    printf("[SERVER] Multi-Service Server active on port %d...\n", PORT);

    // Continuous Acceptance Loop
    while (1) {
        client_fd = accept(server_fd, (struct sockaddr *)&client_addr, &addr_len);
        if (client_fd < 0) continue;

        char client_ip[INET_ADDRSTRLEN];
        inet_ntop(AF_INET, &client_addr.sin_addr, client_ip, INET_ADDRSTRLEN);
        int client_port = ntohs(client_addr.sin_port);

        printf("[SERVER] Connection accepted from %s:%d\n", client_ip, client_port);

        // Fork to handle clients continuously
        if (fork() == 0) {
            close(server_fd); // Child does not need the master listener socket
            serve_client(client_fd, client_ip, client_port);
        }
        close(client_fd); // Parent closes descriptor to prevent exhaustion leaks
    }
    return 0;
}
