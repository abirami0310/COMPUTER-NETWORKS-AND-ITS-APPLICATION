#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8030
#define BUFFER_SIZE 1024

// Structure for storing URL and IP address
struct DNSRecord
{
    char url[100];
    char ip[50];
};

int main()
{
    int sockfd;
    struct sockaddr_in server_addr, client_addr;
    char buffer[BUFFER_SIZE];
    socklen_t addr_len = sizeof(client_addr);

    // DNS table containing 15 URLs and IP addresses
    struct DNSRecord dns_table[] =
    {
        {"www.google.com",        "142.250.195.68"},
        {"www.youtube.com",       "142.250.72.14"},
        {"www.facebook.com",      "157.240.241.35"},
        {"www.instagram.com",     "157.240.241.174"},
        {"www.amazon.com",        "205.251.242.103"},
        {"www.microsoft.com",     "20.76.201.171"},
        {"www.apple.com",         "17.253.144.10"},
        {"www.github.com",        "140.82.112.4"},
        {"www.linkedin.com",      "108.174.10.10"},
        {"www.wikipedia.org",     "208.80.154.224"},
        {"www.reddit.com",        "151.101.1.140"},
        {"www.netflix.com",       "52.85.61.23"},
        {"www.yahoo.com",         "98.137.11.163"},
        {"www.stackoverflow.com", "151.101.1.69"},
        {"www.bing.com",          "204.79.197.200"}
    };

    int total_records =
        sizeof(dns_table) / sizeof(dns_table[0]);

    // Create UDP socket
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("socket failed");
        exit(1);
    }

    // Set server address
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = INADDR_ANY;

    // Bind socket
    if (bind(sockfd,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("bind failed");
        close(sockfd);
        exit(1);
    }

    printf("UDP DNS Server listening on port %d...\n", PORT);
    printf("Waiting for client requests...\n\n");

    // Iterative server
    
    
        // Receive URL from client
        int n = recvfrom(sockfd,
                         buffer,
                         BUFFER_SIZE - 1,
                         0,
                         (struct sockaddr *)&client_addr,
                         &addr_len);

        if (n < 0)
        {
            perror("recvfrom failed");
            close(sockfd);
            exit(1);
        }

        buffer[n] = '\0';

        // Remove newline
        buffer[strcspn(buffer, "\n")] = '\0';

        printf("Client requested: %s\n", buffer);

        int found = 0;
        int i;
        // Search URL in DNS table
        for (i = 0; i < total_records; i++)
        {
            if (strcmp(buffer, dns_table[i].url) == 0)
            {
                char response[BUFFER_SIZE];

                // Create response
                sprintf(response,
                        "URL Found! IP Address: %s",
                        dns_table[i].ip);

                // Send response to client
                sendto(sockfd,
                       response,
                       strlen(response),
                       0,
                       (struct sockaddr *)&client_addr,
                       addr_len);

                printf("URL Found\n");
                printf("IP Address: %s\n\n",
                       dns_table[i].ip);

                found = 1;
                break;
            }
        }

        // If URL is not found
        if (!found)
        {
            char response[] = "URL Not Found";

            sendto(sockfd,
                   response,
                   strlen(response),
                   0,
                   (struct sockaddr *)&client_addr,
                   addr_len);

            printf("URL Not Found\n\n");
        }
    

    close(sockfd);

    return 0;
}
