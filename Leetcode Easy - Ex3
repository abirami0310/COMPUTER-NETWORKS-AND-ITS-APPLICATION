

int hammingDistance(int x, int y) {
    // Compute XOR to find differing bits
    int xor_result = x ^ y;
    int distance = 0;
    
    // Count the number of set bits (1s)
    while (xor_result > 0) {
        distance += xor_result & 1; // Check if the last bit is 1
        xor_result >>= 1;          // Shift right to check the next bit
    }
    
    return distance;
}

