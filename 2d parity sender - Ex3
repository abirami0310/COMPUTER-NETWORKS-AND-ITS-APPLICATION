#include <stdio.h>
int r,c,i,j;
int data[10][10];
int rp[10],cp[10],corner;
void getdata()
{
    printf("Enter number of rows: ");
    scanf("%d",&r);
    printf("Enter number of columns: ");
    scanf("%d",&c);
    printf("Enter %d bits row wise:\n",r*c);
    for(i=0;i<r;i++)
        for(j=0;j<c;j++)
            scanf("%d",&data[i][j]);
}
void calcparity()
{
    for(i=0;i<r;i++)
    {
        rp[i]=0;
        for(j=0;j<c;j++)
            rp[i]=rp[i]^data[i][j];
    }
    for(j=0;j<c;j++)
    {
        cp[j]=0;
        for(i=0;i<r;i++)
            cp[j]=cp[j]^data[i][j];
    }
    corner=0;
    for(j=0;j<c;j++)
        corner=corner^cp[j];
}
void display()
{
    printf("\nData with parity bits:\n");
    for(i=0;i<r;i++)
    {
        for(j=0;j<c;j++)
            printf("%d ",data[i][j]);
        printf("| %d\n",rp[i]);
    }
    for(j=0;j<c;j++)
        printf("--");
    printf("\n");
    for(j=0;j<c;j++)
        printf("%d ",cp[j]);
    printf("| %d\n",corner);
}
void send()
{
    FILE *fp;
    fp=fopen("channel.dat","wb");
    fwrite(&r,sizeof(int),1,fp);
    fwrite(&c,sizeof(int),1,fp);
    fwrite(data,sizeof(int),100,fp);
    fwrite(rp,sizeof(int),10,fp);
    fwrite(cp,sizeof(int),10,fp);
    fwrite(&corner,sizeof(int),1,fp);
    fclose(fp);
    printf("\nData sent to channel (channel.dat).\n");
}
int main()
{
    getdata();
    calcparity();
    display();
    send();
    return 0;
}

